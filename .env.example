# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJklMNopQRstUVwxyz_Example

# Comma-separated list of authorized Telegram numeric user IDs
ALLOWED_USER_IDS=1034877346,987654321

# Host path for temporary download operations
DOWNLOAD_DIR=/tmp/yt_audio_bot

# (Optional) SOCKS5/HTTP proxy for Telegram API if hosted in restricted network
# SOCKS5_PROXY=socks5://127.0.0.1:1080