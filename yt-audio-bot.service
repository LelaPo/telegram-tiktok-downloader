[Unit]
Description=YouTube to MP3 Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/yt-audio-bot
ExecStart=/opt/yt-audio-bot/venv/bin/python3 /opt/yt-audio-bot/main.py
Restart=always
RestartSec=5

# Sandboxing
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target